from pathlib import Path
import json
root=Path('.'); cc=root/'custom_components/zwave_route_optimizer'
# const
p=cc/'const.py'; s=p.read_text(); s=s.replace('DEFAULT_PASSES = 1\n','DEFAULT_PASSES = 1\nDEFAULT_ADAPTIVE_TESTING = True\n'); s=s.replace('DEFAULT_SAMPLE_INTERVAL = 0.05\n','DEFAULT_SAMPLE_INTERVAL = 0.05\nADAPTIVE_DIRECT_MEDIAN_MS = 35.0\nADAPTIVE_DIRECT_WORST_MS = 75.0\nADAPTIVE_ONE_HOP_MEDIAN_MS = 45.0\nADAPTIVE_ONE_HOP_WORST_MS = 100.0\nADAPTIVE_ONE_HOP_PATHS = 3\n'); p.write_text(s)
# init
p=cc/'__init__.py'; s=p.read_text(); s=s.replace('    DEFAULT_PASSES,\n    DEFAULT_ROUNDS,\n','    DEFAULT_PASSES,\n    DEFAULT_ADAPTIVE_TESTING,\n    DEFAULT_ROUNDS,\n'); s=s.replace('ATTR_PASSES = "passes"\n','ATTR_PASSES = "passes"\nATTR_ADAPTIVE_TESTING = "adaptive_testing"\n'); s=s.replace('    vol.Optional(ATTR_INCLUDE_AUTO, default=True): cv.boolean,\n','    vol.Optional(ATTR_INCLUDE_AUTO, default=True): cv.boolean,\n    vol.Optional(ATTR_ADAPTIVE_TESTING, default=DEFAULT_ADAPTIVE_TESTING): cv.boolean,\n'); s=s.replace('        "include_auto": data[ATTR_INCLUDE_AUTO],\n','        "include_auto": data[ATTR_INCLUDE_AUTO],\n        "adaptive_testing": data[ATTR_ADAPTIVE_TESTING],\n'); p.write_text(s)
# manifest
p=cc/'manifest.json'; d=json.loads(p.read_text()); d['version']='0.7.2'; p.write_text(json.dumps(d,indent=2)+'\n')
# services
p=cc/'services.yaml'; s=p.read_text().replace('v0.7.1','v0.7.2'); needle='''    include_auto:\n      name: Test automatic routing\n      default: true\n      selector:\n        boolean: null\n'''; adaptive='''    adaptive_testing:\n      name: Adaptive candidate testing\n      description: Prioritize generated routes using passive Z-Wave JS RSSI and learned-route statistics. Stop early when a clearly good direct or one-hop route is confirmed. Off benchmarks the full generated candidate set.\n      default: true\n      selector:\n        boolean: null\n'''; s=s.replace(needle,needle+adaptive); p.write_text(s)
# README
p=root/'README.md'; s=p.read_text().replace('Version: **0.7.1**','Version: **0.7.2**').replace('disabled in v0.7.1','disabled in v0.7.2').replace('## v0.7.1 behavior','## v0.7.2 behavior'); anchor='- Candidate generation is hop-diverse: direct, 1-hop, 2-hop, etc. receive independent path discovery and round-robin candidate slots so shallow routes cannot starve multi-hop routes.\n'; extra='- **Adaptive candidate testing is enabled by default.** Passive Z-Wave JS node statistics (RSSI plus recently observed LWR/NLWR routes and repeater RSSI when available) are used only to prioritize topology-valid candidates; they never hard-filter a route.\n- Adaptive execution tests current/AUTO baselines first, then shorter generated routes. A clean direct route at or below 35 ms median / 75 ms worst stops route expansion. If direct is not excellent, up to three distinct RF-ranked one-hop paths are tried before deeper routes; a clean one-hop route at or below 45 ms median / 100 ms worst can stop expansion.\n- Disable **Adaptive candidate testing** to benchmark the complete generated candidate set exactly as before.\n'; s=s.replace(anchor,anchor+extra,1); s=s.replace('- Whole-network dry runs support 1–10 complete passes in a single action. The neighbor graph is built once, each pass benchmarks every eligible node, and compact per-pass winner summaries are retained for repeatability comparisons. The top-level `results` field remains the full detailed result from the final pass.\n','- Whole-network dry runs support 1–10 complete passes in a single action. The neighbor graph is built once, each pass benchmarks every eligible node, and compact per-pass winner summaries are retained for repeatability comparisons. Those summaries also report how many candidates adaptive testing actually measured/skipped. The top-level `results` field remains the full detailed result from the final pass.\n'); p.write_text(s)
# review append v071 section + v072 section
